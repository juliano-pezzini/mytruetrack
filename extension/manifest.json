{
  "manifest_version": 3,
  "name": "mytruetrack InvestPass Import",
  "version": "0.1.0",
  "description": "Companion extension for importing InvestPass transactions into mytruetrack",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://pass-api.invest-pass.com/*",
    "https://app.invest-pass.com/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:*/*", "https://localhost:*/*"]
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
